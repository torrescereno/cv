---
import Jobs from "./Jobs.astro";
import jobs from "../../data/jobs.json";
---

<section class="mt-4 border-t border-neutral-200 dark:border-neutral-800 pt-4">
  <div class="px-5">
    <h2 class="font-semibold text-sm text-neutral-500 dark:text-neutral-500 uppercase tracking-wide mb-4">Experiencia</h2>
    <div class="space-y-5">
      {jobs.map((job) => (
        <Jobs
          title={job.title}
          company={job.company}
          date={job.date}
          description={job.description}
        />
      ))}
    </div>
  </div>
</section>
